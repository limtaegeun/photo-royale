rules_version = '2';

// Firestore 보안 규칙의 단일 진실원. 변경 후 `firebase deploy --only firestore:rules`로
// 배포한다(firebase.json에 연결됨). 콘솔에서 직접 수정하면 이 파일과 어긋나므로 금지.
service cloud.firestore {
  match /databases/{database}/documents {
    // 신규 users 문서 스키마 검증 — 필드 화이트리스트 + 타입/값/길이 제약.
    // 정상 클라이언트(useSignup)와 같은 규칙(닉네임 2~12자, 한글·영문·숫자)을 서버에서도
    // 강제해, SDK 직접 호출로 예약 키와 다른 표시 닉네임·임의 필드·비정상 gender를
    // 쓰는 것을 막는다. 한계: rules는 NFC 정규화를 못 하므로 유니코드 정규화 자체는
    // 클라이언트(toNicknameKey) 책임으로 남는다.
    function isValidNewUser(data) {
      return data.keys().hasAll(['email', 'nickname', 'nicknameKey', 'gender', 'createdAt'])
        && data.keys().hasOnly(['email', 'nickname', 'nicknameKey', 'gender', 'createdAt'])
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 320
        && data.nickname is string
        && data.nickname.size() >= 2
        && data.nickname.size() <= 12
        && data.nickname.matches('^[가-힣ㄱ-ㅎㅏ-ㅣA-Za-z0-9]+$')
        && data.nicknameKey == data.nickname.lower()
        && data.gender in ['male', 'female']
        && data.createdAt == request.time; // serverTimestamp()는 rules에서 request.time과 같다
    }

    // 라운드 타이머(rooms/{code}.round) 스키마 검증 — 필드 화이트리스트 + 타입/값 제약.
    // 남은 시간은 저장하지 않고 앵커(startedAt) + 총량(durationMs)으로만 표현한다
    // (src/features/round-ops/api/round.ts writeRound과 같은 규칙).
    // durationMs 상한(3시간=10800000)은 클라의 ROUND_DURATION_MAX_MS와 **숫자까지 동일**해야
    // 하며 round.spec이 이 파일을 읽어 대조 검증한다 — 변경 시 양쪽을 함께 갱신·배포할 것.
    function isValidRound(round) {
      return round.keys().hasAll(['status', 'startedAt', 'durationMs'])
        && round.keys().hasOnly(['status', 'startedAt', 'durationMs', 'pausedRemainingMs'])
        && round.status in ['running', 'paused']
        && round.startedAt is timestamp
        && round.durationMs is int
        && round.durationMs >= 0
        && round.durationMs <= 10800000
        // 정지 중에만 남은 시간을 고정한다. 진행 중에 이 필드가 남아 있으면 어느 값이 정본인지
        // 모호해지므로 부재를 강제한다.
        && (round.status == 'paused'
          ? (round.pausedRemainingMs is int
            && round.pausedRemainingMs >= 0
            && round.pausedRemainingMs <= 10800000)
          : !('pausedRemainingMs' in round));
    }

    // 탈락 팀(P07 M3) 판정 — 원장 hits가 라이프에 닿은 팀. 라이프는 2인 팀 1·1인 팀 2로
    // src/features/game-mode/scoring.ts의 livesOf와 **같아야 한다**(변경 시 양쪽을 함께 갱신·배포할 것).
    // 콕핏은 이미 탈락 팀의 셔터·제출을 잠그지만 클라를 우회한 쓰기는 그것만으로는 통과하므로
    // 서버에서도 같은 기준으로 막는다(p07-elimination §5). 스냅샷에 없는 완장은 판정 근거가 없어 탈락이 아니다.
    function isTeamOutInLedger(ledger, team) {
      return 'hits' in ledger
        && team in ledger.hits
        && team in ledger.teams
        && ledger.hits[team] >= (ledger.teams[team].size() == 1 ? 2 : 1);
    }

    // 방 삭제(P09) — 요청자가 이 방의 호스트이고 방이 삭제 표식(deleting)을 달았는가.
    // 하위 문서(킬샷·원장·공지·지도) 삭제 갈래가 전부 이 함수를 요구한다 — 서버 함수가 없어 하위
    // 컬렉션은 진행자 기기가 지우는데, 표식 없이 열면 삭제 흐름 밖에서 원장·킬샷을 지울 길이 생긴다.
    // 표식은 rooms update 5번 갈래(방 닫기)로만 달린다(docs/plans/p09-room-delete.md §4).
    function isDeletingRoomHost(roomCode) {
      let room = get(/databases/$(database)/documents/rooms/$(roomCode)).data;
      return request.auth != null
        && room.hostUid == request.auth.uid
        && room.get('deleting', false) == true;
    }

    // 같은 차수 재배정(P10) — 방이 대기 중이고, 지금 차수로 아직 게임을 시작하지 않았고(playedRound),
    // 이 배치가 차수를 올리지 않는가. 배정은 확정했지만 게임 전인 차수를 다시 짜는 진행자 흐름이다.
    // 참가자 배정 풀기(participants update ③)와 편성 스냅샷 덮어쓰기(rounds update ⑤)가 요구한다.
    // playedRound는 게임 시작(rooms update ①)이 함께 쓴다 — 필드를 모르는 옛 앱이 시작한 차수는
    // 기록이 없어 '아직 안 함'으로 읽힌다(배포 전환기 한계, docs/plans/p10-reassign-same-round.md §4).
    function isUnplayedRoundReassign(roomCode) {
      let room = get(/databases/$(database)/documents/rooms/$(roomCode)).data;
      let roomAfter = getAfter(/databases/$(database)/documents/rooms/$(roomCode)).data;
      return room.status == 'waiting'
        && room.get('assignmentRound', 0) > 0
        && room.get('playedRound', 0) != room.get('assignmentRound', 0)
        && roomAfter.get('assignmentRound', 0) == room.get('assignmentRound', 0);
    }

    // 닉네임 유니크 인덱스. 문서 ID = 정규화 키(trim → NFC → lowercase,
    // src/features/auth/api/signup.ts toNicknameKey와 동일 규칙), 내용은 소유자 uid뿐.
    match /nicknames/{nickname} {
      // 가입 폼의 미인증 가용성 검사는 단건 get만 허용하고,
      // list를 막아 닉네임 전체 수집을 방지한다.
      allow get: if true;
      allow list: if false;

      // 존재하지 않는 키에만 create가 성립하므로 유니크가 서버에서 강제된다.
      // 같은 트랜잭션에서 users/{uid}가 이 키를 nicknameKey로 참조해야 한다(getAfter).
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.nicknameKey == nickname;

      // 닉네임 변경/탈퇴 플로우 도입 전까지 예약은 불변이다.
      allow update, delete: if false;
    }

    match /users/{uid} {
      // 프로필(이메일 포함)은 본인만 읽는다. 닉네임 가용성 검사는 nicknames 컬렉션이
      // 담당하므로 users를 공개로 열 이유가 없다.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;

      // 본인 문서이면서 스키마 검증(isValidNewUser)을 통과하고, 같은 트랜잭션에
      // 닉네임 예약이 함께 있어야 생성된다(상호 참조).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isValidNewUser(request.resource.data)
        && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nicknameKey)).data.uid == uid;

      // 프로필 수정 플로우 도입 시 닉네임 재예약 규칙과 함께 재설계한다.
      allow update, delete: if false;
    }

    // 대기실. 문서 ID = 초대 코드(waiting-room/api/rooms.ts generateRoomCode와 동일 형식 —
    // 혼동 문자 0/O·1/I/L 제외 4자).
    match /rooms/{roomCode} {
      // 초대 코드를 아는 로그인 사용자만 단건 조회한다(입장 전 코드 검증·참가 트랜잭션).
      allow get: if request.auth != null;

      // list는 "내가 만든 방" 조회(where hostUid == 본인)를 만족하는 쿼리만 허용한다 —
      // 조건 없는 전체 방 코드 수집은 계속 거부된다(fetchMyRooms 참조).
      allow list: if request.auth != null
        && resource.data.hostUid == request.auth.uid;

      // 존재하지 않는 코드에만 create가 성립하므로(createRoom 트랜잭션의 존재 검사와 함께)
      // 코드 유니크가 서버에서 강제된다. 정규식은 rooms.ts의 ROOM_CODE_ALPHABET·LENGTH와
      // 같은 규칙이어야 한다(rooms.spec이 대조 검증) — 변경 시 양쪽을 함께 갱신·배포할 것.
      allow create: if request.auth != null
        && roomCode.matches('^[A-HJKMNP-Z2-9]{4}$')
        && request.resource.data.keys().hasOnly(['hostUid', 'status', 'createdAt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt == request.time;

      // 호스트 본인만. 네 갈래로 나뉜다. (행사장 지도는 방 문서가 아니라 assets/venueMap 문서에 있다)
      allow update: if request.auth != null
        && request.auth.uid == resource.data.hostUid
        && (
          // 1) 게임 시작 — waiting → playing 단방향 전이만 허용한다. 이 차수로 게임을 시작했다는
          //    기록(playedRound = 지금 차수)을 같이 쓸 수 있다(P10) — 같은 차수 재배정이 이 기록으로
          //    "아직 안 한 차수"를 가린다. 기록을 모르는 옛 앱의 시작도 통과해야 하므로 없어도 된다.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'playedRound'])
            && resource.data.status == 'waiting'
            && request.resource.data.status == 'playing'
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['playedRound'])
              || request.resource.data.playedRound == resource.data.get('assignmentRound', 0)))
          // 2) 배정 확정 — 팀편성 차수와 게임 모드, 그리고 차수 → 모드 이력(roundModes)을
          //    함께 커밋한다. 아직 대기 중일 때만 허용한다.
          //    차수는 +1(다음 차수 배정)이거나, 아직 게임을 시작하지 않은 지금 차수 그대로(P10 같은
          //    차수 재배정)다. 재배정은 같은 배치가 그 차수 원장(rounds/{차수})의 편성 스냅샷을 새 모드로
          //    다시 써야 성립한다(getAfter 대조) — 모드만 단독으로 바꾸는 요청은 원장 모드가 그대로라
          //    거부되고, 게임을 시작한 차수(playedRound)는 다시 짤 수 없다.
          //    아래 모드 리스트는 src/features/game-mode/registry.ts의 GAME_MODE_IDS와 일치해야
          //    한다(registry.spec이 대조 검증) — 새 모드 추가 시 여기도 갱신하고 rules를 배포할 것.
          //    roundModes는 gameMode가 덮어써져 사라지는 과거 라운드 모드를 남기는 이력 맵이다.
          //    이번 확정 차수의 키 하나만 추가/변경할 수 있고 값은 함께 커밋되는 gameMode와 같아야
          //    한다(모드 화이트리스트 검증은 위 gameMode 조건이 이미 수행하므로 등식으로 전이된다).
          //    기존 키 변조·삭제는 diff의 affectedKeys 제약이 막는다. 필드가 실제로 실렸을 때만
          //    검증하므로, roundModes를 모르는 구버전 클라이언트의 확정도 그대로 통과한다(배포 순서 자유).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignmentRound', 'gameMode', 'roundModes'])
            && resource.data.status == 'waiting'
            && request.resource.data.assignmentRound is int
            && (request.resource.data.assignmentRound ==
                (('assignmentRound' in resource.data) ? resource.data.assignmentRound + 1 : 1)
              || ('assignmentRound' in resource.data
                && resource.data.assignmentRound > 0
                && request.resource.data.assignmentRound == resource.data.assignmentRound
                && resource.data.get('playedRound', 0) != resource.data.assignmentRound
                && getAfter(/databases/$(database)/documents/rooms/$(roomCode)/rounds/$(string(resource.data.assignmentRound))).data.mode
                  == request.resource.data.gameMode))
            && request.resource.data.gameMode in ['normal', 'tail-chase', 'group', 'king-hunt', 'staff-chase', 'bomb-plant', 'kkomkkomi', 'fast-survival']
            && (!('roundModes' in request.resource.data)
              || (request.resource.data.roundModes is map
                && request.resource.data.roundModes.diff(resource.data.get('roundModes', {})).affectedKeys()
                  .hasOnly([string(request.resource.data.assignmentRound)])
                && request.resource.data.roundModes[string(request.resource.data.assignmentRound)]
                  == request.resource.data.gameMode)))
          // 3) 라운드 운영(H04) — 게임이 진행 중일 때만 round 맵을 통째로 갱신한다.
          //    시작·정지·재개·시간 반영이 모두 같은 갈래를 탄다(전이 종류는 클라가 결정하고,
          //    서버는 결과 문서가 유효한 라운드 상태인지만 본다).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['round'])
            && resource.data.status == 'playing'
            && isValidRound(request.resource.data.round))
          // 4) 게임 종료 — playing → waiting으로 되돌리며 진행 중인 라운드를 지운다.
          //    1번 갈래가 status를 단방향으로만 열어 두어 오시작을 콘솔로만 되돌릴 수 있었다.
          //    되돌리기는 status와 round를 **한 번에** 바꿔야 하므로(둘로 나누면 라운드만 남거나
          //    대기 상태에 라운드가 붙은 중간 상태가 보인다) 두 키를 함께 허용하는 갈래를 둔다.
          //    round가 없던(시작 전) 방은 affectedKeys가 ['status']뿐이라 hasOnly가 그대로 통과한다.
          //    배정 이력(assignmentRound·완장)은 건드리지 않는다 — 대기실로 돌아가 재배정하면
          //    기존 라운드 루프가 그대로 이어진다.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'round'])
            && resource.data.status == 'playing'
            && request.resource.data.status == 'waiting'
            && !('round' in request.resource.data))
          // 5) 방 닫기(P09 방 삭제의 첫 단계) — 어느 상태(대기·진행)에서든 대기로 되돌리고 진행 중인
          //    라운드를 지우며 삭제 표식(deleting)을 단다. 진행 중인 방이면 4번 갈래의 게임 종료와 같은
          //    전이라 참가자 화면이 대기실로 돌아온다. 표식이 달린 방은 새 참가자를 받지 않고
          //    (participants create), 하위 문서·방 문서 삭제 갈래가 이 표식을 요구한다.
          //    이미 닫힌 방에 다시 쓰면 affectedKeys가 비어 그대로 통과한다(중간에 실패한 삭제의 재시도).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'round', 'deleting'])
            && request.resource.data.deleting == true
            && request.resource.data.status == 'waiting'
            && !('round' in request.resource.data))
        );

      // 방 삭제(P09) — 호스트가 닫은(deleting) 방만. 하위 문서를 먼저 지우고 방 문서를 마지막에
      // 지운다 — 방 문서가 남아 있어야 중간에 실패한 삭제를 진행자 목록에서 다시 이어 갈 수 있다.
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.hostUid
        && resource.data.get('deleting', false) == true;

      // 참가자. 문서 ID = 참가자 uid — 재입장(joinRoom)이 자연스럽게 멱등이 된다.
      match /participants/{uid} {
        // 명단은 같은 방 사람끼리 실시간 구독으로 봐야 한다. 경로 접근에 초대 코드가
        // 필요하므로 로그인 사용자 전체 허용으로 충분하다(MVP).
        allow read: if request.auth != null;

        // 본인 문서만, 대기(isReady=false) 상태로, 존재하는 방에만 생성한다.
        // 닉네임은 users 스키마와 같은 제약(2~12자, 한글·영문·숫자)을 강제한다.
        // gender는 명단 표기용 optional — 있으면 값을 검증한다(프로필 조회 실패 시 생략 허용).
        // 삭제 중(deleting)인 방에는 들어올 수 없다 — 지우는 사이 들어온 참가자가 방 문서가
        // 사라진 뒤 고아 문서로 남아, 같은 코드로 만든 새 방에 유령 참가자로 보이지 않게 한다(P09).
        allow create: if request.auth != null
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/rooms/$(roomCode))
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.get('deleting', false) == false
          && request.resource.data.keys().hasAll(['nickname', 'isReady', 'joinedAt'])
          && request.resource.data.keys().hasOnly(['nickname', 'gender', 'isReady', 'joinedAt'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 2
          && request.resource.data.nickname.size() <= 12
          && request.resource.data.nickname.matches('^[가-힣ㄱ-ㅎㅏ-ㅣA-Za-z0-9]+$')
          && (!('gender' in request.resource.data) || request.resource.data.gender in ['male', 'female'])
          && request.resource.data.isReady == false
          && request.resource.data.joinedAt == request.time;

        // 세 갈래로 나뉜다.
        allow update: if
          // 1) 본인의 레디 확정만 허용한다(레디 해제 플로우는 아직 없다).
          (request.auth != null
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReady'])
            && request.resource.data.isReady == true)
          // 2) 호스트 배정 확정 배치 쓰기 — 드래프트는 로컬이라 확정 시에만 서버에 닿는다.
          //    team(완장)·확정 차수·X 겸직·이월값을 쓰고, 라운드마다 재레디를 위해 isReady를 false로 리셋한다.
          //    assignedRound는 getAfter로 방 문서의 커밋 후 assignmentRound와 일치해야 한다 —
          //    즉 참가자 배정 쓰기는 방 차수 증가와 같은 배치에만 성립한다(참가자만 단독 수정 불가).
          //    base* 두 키는 이번 확정 직전의 이월값이다(P10) — 같은 차수를 다시 짤 때 이 값에서 다시
          //    계산해, 게임도 안 한 편성이 짝꿍 이력·연속 비혼성 횟수에 쌓이지 않게 한다. 두 키를 모르는
          //    옛 앱의 확정도 통과해야 하므로 없어도 된다.
          || (request.auth != null
            && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['team', 'assignedRound', 'isXTeam', 'sameGenderStreak', 'previousPartnerIds', 'isReady', 'baseSameGenderStreak', 'basePreviousPartnerIds'])
            && (!('baseSameGenderStreak' in request.resource.data)
              || (request.resource.data.baseSameGenderStreak is int
                && request.resource.data.baseSameGenderStreak >= 0))
            && (!('basePreviousPartnerIds' in request.resource.data)
              || request.resource.data.basePreviousPartnerIds is list)
            && request.resource.data.team is string
            && request.resource.data.team.size() == 1
            && request.resource.data.team.matches('^[A-Z]$')
            && request.resource.data.assignedRound is int
            && request.resource.data.assignedRound ==
              getAfter(/databases/$(database)/documents/rooms/$(roomCode)).data.assignmentRound
            && request.resource.data.isXTeam is bool
            && request.resource.data.sameGenderStreak is int
            && request.resource.data.sameGenderStreak >= 0
            && request.resource.data.previousPartnerIds is list
            && request.resource.data.isReady == false)
          // 3) 같은 차수 재배정에서 빠진 참가자(P10) — 지금 차수에 배정돼 있던 사람이 새 편성에서
          //    미배정 대기자로 남으면 그 차수 배정을 푼다. 완장·차수·X 겸직·base* 키를 지우고 이월값을
          //    배정 전 값(base*)으로 되돌린다. 차수를 올리는 확정은 미배정자를 건드리지 않으므로(차수
          //    마커가 어긋나 저절로 미배정이 된다) 이 갈래는 게임 전 같은 차수 재배정에만 열린다.
          || (request.auth != null
            && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
            && isUnplayedRoundReassign(roomCode)
            && resource.data.get('assignedRound', 0)
              == get(/databases/$(database)/documents/rooms/$(roomCode)).data.assignmentRound
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['team', 'assignedRound', 'isXTeam', 'sameGenderStreak', 'previousPartnerIds', 'baseSameGenderStreak', 'basePreviousPartnerIds'])
            && !('team' in request.resource.data)
            && !('assignedRound' in request.resource.data)
            && !('isXTeam' in request.resource.data)
            && !('baseSameGenderStreak' in request.resource.data)
            && !('basePreviousPartnerIds' in request.resource.data)
            && request.resource.data.sameGenderStreak is int
            && request.resource.data.sameGenderStreak >= 0
            && request.resource.data.previousPartnerIds is list);

        // 강퇴 — 호스트가 대기 중(waiting)에만 참가자를 내보낸다(문서 삭제). 응답 없는
        // 참가자가 "전원 준비" 조건을 영원히 막아 다음 배정이 열리지 않는 것을 푸는 운영
        // 조치다. 게임 중(playing) 삭제는 계속 잠근다 — 킬샷 판정이 대상 참가자 문서를
        // 대조(get)하고 팀원 명단도 이 문서를 읽으므로, 진행 중 삭제는 그 근거를 부순다.
        // 한계: waiting은 라운드 사이(게임 종료 후)이기도 해서, 그때의 강퇴는 그 사람을
        // 찍은 미판정 킬샷의 승인 근거를 지운다(반려만 가능) — 같은 차수 재시작으로 큐가
        // 부활한 경우에만 닿는 좁은 창이라 감수한다(docs/qa/waiting-room.md 한계 #12).
        // 재입장은 막지 않는다(초대 코드가 곧 입장 자격이고 joinRoom이 멱등이다) — 차단이
        // 아니므로, 내보낸 사람이 돌아오면 새 참가자로 다시 들어온다(짝꿍 이력은 초기화).
        // 배정 확정 뒤·게임 시작 전의 강퇴는 같은 배치로 그 차수 원장 teams에서도 뺀다(rounds
        // update 갈래 ④) — 이 삭제 갈래는 그대로이고, 원장을 안 고치는 옛 클라이언트도 통과한다.
        // 본인 퇴장(자진 나가기)은 아직 플로우가 없어 호스트 외에는 계속 불변이다.
        // 방 삭제(P09) — 닫힌(deleting) 방이면 상태와 무관하게 호스트가 지운다(방 문서와 같은 배치).
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          && (get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'waiting'
            || isDeletingRoomHost(roomCode));
      }

      // 방 자산(P08 §2.2) — 지금은 행사장 지도 한 장(문서 ID venueMap)뿐이다. 진행자가 이미지 파일을 올리면
      // 클라가 다운스케일·압축한 JPEG 데이터 URL로 문서에 인라인 저장한다(킬샷 사진과 같은 방식, Storage 없음).
      // 방 문서와 따로 두는 이유: 방 문서는 참가자 전원이 계속 구독하므로 거기 실으면 방이 바뀔 때마다
      // 지도가 전원에게 다시 내려간다.
      match /assets/{assetId} {
        // 문서가 커서(1MB 가까이) 초대 코드만 아는 사용자에게는 열지 않는다 — 호스트와 그 방 참가자만
        // 읽는다(submissions와 같은 기준). 참가자는 대기실에서 미리 받아 두고 콕핏에서 연다.
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
            || exists(/databases/$(database)/documents/rooms/$(roomCode)/participants/$(request.auth.uid)));

        // 호스트 본인만 venueMap 문서를 통째로 쓴다(등록·바꾸기). 방 상태(대기·게임 중)와 무관하다 —
        // 게임 중에 바꾸면 참가자는 1분 안에, 또는 지도를 열 때 새 지도를 받는다(useVenueMapStore). 길이 상한(1000000)은
        // src/features/waiting-room/api/venueMap.ts의 VENUE_MAP_IMAGE_MAX_LENGTH와 **숫자까지 동일**해야
        // 한다(venueMap.spec이 대조 검증 — 변경 시 양쪽을 함께 갱신·배포할 것).
        allow create, update: if request.auth != null
          && assetId == 'venueMap'
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          && request.resource.data.keys().hasAll(['image', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['image', 'updatedAt'])
          && request.resource.data.image is string
          && request.resource.data.image.size() >= 1
          && request.resource.data.image.size() <= 1000000
          && request.resource.data.image.matches('^data:image/jpeg;base64,.*')
          && request.resource.data.updatedAt == request.time;

        // 지도만 지우는 플로우는 없다(바꾸기만 한다). 방 삭제(P09) 때만 함께 지운다.
        allow delete: if isDeletingRoomHost(roomCode);
      }

      // 진행자 공지. append-only 히스토리 — 운영 탭은 최신 1건을 구독하고,
      // 기록 탭(후속)이 같은 컬렉션을 전체 이력으로 읽는다.
      match /notices/{noticeId} {
        // 참가자가 같은 방 경로로 구독한다(participants와 동일 정책 — 경로 접근에 초대 코드 필요).
        allow read: if request.auth != null;

        // 호스트 본인만 발행한다. 길이 상한(100)은 src/features/round-ops/api/notices.ts의
        // NOTICE_TEXT_MAX_LENGTH와 같아야 한다(notices.spec이 대조 검증).
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 100
          && request.resource.data.createdAt == request.time;

        // 보낸 공지는 정정하지 않고 새 공지로 덮는다(이력 보존). 방 삭제(P09) 때만 함께 지운다.
        allow update: if false;
        allow delete: if isDeletingRoomHost(roomCode);
      }

      // 킬샷 제출·판정 큐. 참가자가 append하고 호스트가 pending → approved/rejected로
      // 한 번만 판정한다(재판정·삭제 없음). 사진은 Storage 없이 JPEG 데이터 URL로 문서에
      // 인라인 저장한다(문서 한도 1MiB 안에서 클라이언트가 다운스케일·압축한다).
      match /submissions/{submissionId} {
        // 사진 원문(data URL)은 민감하고 용량도 크다. 방 호스트 또는 실제 참가자만 열람한다.
        // 초대 코드를 알기만 하는 다른 로그인 사용자의 단건 조회·전체 큐 구독은 거부한다.
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
            || exists(/databases/$(database)/documents/rooms/$(roomCode)/participants/$(request.auth.uid)));

        // 이번 라운드에 배정된 참가자 본인만 제출한다. team/round는 위조를 막기 위해
        // 본인 참가자 문서·방 문서와 대조한다(같은 문서 get은 평가 안에서 캐시된다).
        // photo 길이 상한(900000)은 src/features/round-ops/api/submissions.ts의
        // SUBMISSION_PHOTO_MAX_LENGTH와 **숫자까지 동일**해야 한다(submissions.spec이 대조 검증).
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['uid', 'team', 'round', 'photo', 'status', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'team', 'round', 'photo', 'status', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'playing'
          // 정지(paused) 중·라운드 시작 전 제출을 서버에서도 차단한다(클라 잠금과 같은 기준).
          // rules의 get은 같은 문서라 추가 비용이 없다.
          && ('round' in get(/databases/$(database)/documents/rooms/$(roomCode)).data)
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.round.status == 'running'
          // 마감(0:00) 이후 도착분은 거부한다 — 라운드가 끝난 뒤 올라온 사진은 킬로 인정하지 않는다.
          // 클라(카메라)는 이미 셔터·제출을 잠그지만 그것만으로는 클라를 우회한 쓰기가 통과하고,
          // 마감 직전 제출이 업로드 지연으로 늦게 도착하는 경우도 걸러지지 않는다.
          //
          // 마감 시각은 `startedAt + durationMs` 하나로 정해진다 — writeRound가 모든 전이
          // (시작·정지·재개·시간 반영)를 "지금부터 남은 시간만큼"으로 다시 앵커하기 때문에,
          // 진행자가 ±N분을 반영하면 이 식이 그대로 따라온다. 판정 기준 시각은 호스트 기기가
          // 아니라 요청이 서버에 닿은 시각(request.time)이라 참가자 기기 시계는 개입하지 못한다.
          // 경계는 클라의 종료 판정(remainingMs == 0 → 'ended')과 같다.
          && request.time < get(/databases/$(database)/documents/rooms/$(roomCode)).data.round.startedAt
            + duration.value(get(/databases/$(database)/documents/rooms/$(roomCode)).data.round.durationMs, 'ms')
          && request.resource.data.round is int
          && request.resource.data.round
            == get(/databases/$(database)/documents/rooms/$(roomCode)).data.assignmentRound
          && request.resource.data.team
            == get(/databases/$(database)/documents/rooms/$(roomCode)/participants/$(request.auth.uid)).data.team
          && request.resource.data.round
            == get(/databases/$(database)/documents/rooms/$(roomCode)/participants/$(request.auth.uid)).data.assignedRound
          && request.resource.data.photo is string
          && request.resource.data.photo.size() >= 1
          && request.resource.data.photo.size() <= 900000
          && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          // 탈락 팀은 제출할 수 없다 — 콕핏 잠금과 같은 기준을 서버에서도(P07 M3). 원장 문서가 없는
          // 라운드(도입 전 배정)는 탈락 판정이 없으니 그대로 통과한다. 원장 접근은 exists+get 한 문서다.
          && (!exists(/databases/$(database)/documents/rooms/$(roomCode)/rounds/$(string(request.resource.data.round)))
            || !isTeamOutInLedger(
              get(/databases/$(database)/documents/rooms/$(roomCode)/rounds/$(string(request.resource.data.round))).data,
              request.resource.data.team));

        // 판정 — 호스트 본인이 pending에 한해 한 번만(단방향). approved(확정)면 잡힌 팀의
        // 완장(targetTeam)이 필수이고, rejected(반려)는 사유 없이 상태만 남긴다. 예외는 자동 반려다:
        // 팀을 탈락시키는 확정이 그 팀의 늦은 대기 킬샷을 같은 배치로 반려하며 rejectReason 'team-out'을 남긴다.
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'playing'
          && resource.data.status == 'pending'
          && resource.data.round
            == get(/databases/$(database)/documents/rooms/$(roomCode)).data.assignmentRound
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'targetTeam', 'targetParticipantUid', 'judgedAt', 'multiplier', 'rejectReason'])
          && request.resource.data.judgedAt == request.time
          && (
            // 확정에는 킬 배율(P07 M2)을 붙일 수 있다 — 1(일반) 또는 3(낙오 포착). 배율을 모르는
            // 구버전 클라이언트의 확정도 통과해야 하므로 필드 부재를 허용한다(배포 순서 자유).
            (request.resource.data.status == 'approved'
              && !('rejectReason' in request.resource.data)
              && (!('multiplier' in request.resource.data)
                || (request.resource.data.multiplier is int
                  && request.resource.data.multiplier in [1, 3]))
              && request.resource.data.targetTeam is string
              && request.resource.data.targetTeam.size() == 1
              && request.resource.data.targetTeam.matches('^[A-Z]$')
              && request.resource.data.targetTeam != resource.data.team
              && request.resource.data.targetParticipantUid is string
              && request.resource.data.targetTeam
                == get(/databases/$(database)/documents/rooms/$(roomCode)/participants/$(request.resource.data.targetParticipantUid)).data.team
              && resource.data.round
                == get(/databases/$(database)/documents/rooms/$(roomCode)/participants/$(request.resource.data.targetParticipantUid)).data.assignedRound)
            || (request.resource.data.status == 'rejected'
              && !('targetTeam' in request.resource.data)
              && !('targetParticipantUid' in request.resource.data)
              && !('multiplier' in request.resource.data)
              && (!('rejectReason' in request.resource.data)
                || request.resource.data.rejectReason == 'team-out'))
          );

        // 판정 이력은 정정하지 않는다(재판정 없음). 방 삭제(P09) 때만 사진과 함께 지운다.
        allow delete: if isDeletingRoomHost(roomCode);
      }

      // 킬샷 과열(P19, docs/plans/p19-killshot-overheat.md) — 참가자마다 문서 하나. 킬샷 제출과 같은 배치로
      // 덮어쓴다. 열(heat)은 초 단위 숫자로 1칸 = 3, 꽉 참 = 12이고, 마지막 제출 뒤 흐른 초만큼 식는다.
      // 다음 1칸이 들어갈 자리가 없으면 쓰기가 거부되고, 같은 배치의 제출도 함께 거부된다.
      // 3과 12는 src/features/round-ops/api/killshotCooldown.ts의 KILLSHOT_HEAT_PER_SUBMIT_SEC ·
      // KILLSHOT_HEAT_CAP_SEC와 **숫자까지 동일**해야 한다(killshotCooldown.spec이 대조 검증).
      // 참가자 문서에 넣지 않는 이유 — 콕핏이 참가자 전원을 구독해서 제출 1건이 전원의 읽기로 번진다.
      match /killshotCooldowns/{uid} {
        // 서버가 계산한 식은 열. 앱 오차를 덮으려고 0.5초 더 식힌다. 0 아래로 내려가도 쓰는 쪽의 `>= 3`이
        // 함께 걸리므로 자르지 않는다.
        function cooledHeat() {
          return resource.data.heat - 0.5
            - (request.time.toMillis() - resource.data.lastAt.toMillis()) / 1000.0;
        }

        function isValidCooldownWrite() {
          return request.auth != null
            && request.auth.uid == uid
            && request.resource.data.keys().hasAll(['round', 'heat', 'lastAt'])
            && request.resource.data.keys().hasOnly(['round', 'heat', 'lastAt'])
            && request.resource.data.lastAt == request.time
            && request.resource.data.heat is number
            && request.resource.data.heat >= 3
            && request.resource.data.heat <= 12
            && request.resource.data.round is int
            && request.resource.data.round
              == get(/databases/$(database)/documents/rooms/$(roomCode)).data.assignmentRound;
        }

        // 본인이 남은 잠금을 읽고, 진행자는 방 삭제(P09) 때 목록을 읽는다
        allow read: if request.auth != null
          && (request.auth.uid == uid
            || get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid);

        allow create: if isValidCooldownWrite();

        // 지난 라운드의 열은 보지 않는다. 같은 라운드면 식은 열에 1칸을 더한 값 이상이어야 하고, 꽉 찬 12를
        // 넘지 않아야 한다 — 그래서 열이 차 있는 동안은 쓸 수 없다.
        allow update: if isValidCooldownWrite()
          && (resource.data.round != request.resource.data.round
            || request.resource.data.heat >= cooledHeat() + 3);

        allow delete: if isDeletingRoomHost(roomCode);
      }

      // 라운드 원장(P07). 문서 ID = 팀편성 차수(rooms.assignmentRound) 문자열. 사진이 실린
      // submissions를 열지 않고 점수·순위를 내기 위한 경량 문서로, 네 시점에 네 갈래로 쓴다 —
      // 배정 확정(편성 스냅샷 create) · 배정 뒤 내보내기(편성 빼기 update) · 판정 확정(집계
      // update) · 라운드 종료(정산 update).
      // 점수 계산 주체는 호스트 클라이언트다(서버 함수 없음). rules는 "누가 언제 어떤 키를"만
      // 검증하고 수치는 신뢰한다. 키 목록은 src/features/round-ledger/types.ts와 같아야 한다
      // (round-ledger의 rules 동기화 가드 스펙이 대조 검증).
      match /rounds/{roundNo} {
        // 순위는 전원이 본다(participants·notices와 같은 정책 — 경로 접근에 초대 코드 필요).
        allow read: if request.auth != null;

        // 1) 배정 확정 배치 — 편성 스냅샷. 방 문서의 차수 증가와 같은 배치에만 성립한다:
        //    문서 ID와 mode를 커밋 후 방 문서(getAfter)의 assignmentRound·gameMode와 대조하므로
        //    스냅샷만 단독으로 만들거나 다른 차수·다른 모드로 만들 수 없다.
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'waiting'
          && roundNo == string(getAfter(/databases/$(database)/documents/rooms/$(roomCode)).data.assignmentRound)
          && request.resource.data.keys().hasAll(['mode', 'teams', 'xTeams', 'confirmedAt'])
          && request.resource.data.keys().hasOnly(['mode', 'teams', 'xTeams', 'confirmedAt'])
          && request.resource.data.mode
            == getAfter(/databases/$(database)/documents/rooms/$(roomCode)).data.gameMode
          && request.resource.data.teams is map
          && request.resource.data.xTeams is list
          && request.resource.data.confirmedAt == request.time;

        // 호스트 본인이 현재 차수 문서에만 쓴다. 게임 중(playing) 두 갈래와 대기 중(waiting) 두 갈래로 나뉜다.
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          && roundNo == string(get(/databases/$(database)/documents/rooms/$(roomCode)).data.assignmentRound)
          && (
            (get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'playing'
              && (
                // 2) 판정 집계 — 판정(approve) 배치가 공격 완장별 tally·피격 완장별 hits를 increment로
                //    올린다. 게임 중에만, 이 네 키만. (판정 자체의 조건은 submissions 갈래가 검증한다.)
                //    꼬리잡기 편입(tails — 완장별 편입 uid 목록)·킬 크레딧(credits — uid별 킬 시점 소속
                //    건수)은 같은 판정 배치가 같은 갈래로 쓴다(P07 §4.2). 없어도 되는 키다 — 편입이 없는
                //    다른 모드와 두 키를 모르는 옛 클라이언트의 판정도 통과해야 한다(rules 선배포).
                (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tally', 'hits', 'tails', 'credits'])
                  && request.resource.data.tally is map
                  && request.resource.data.hits is map
                  && (!('tails' in request.resource.data) || request.resource.data.tails is map)
                  && (!('credits' in request.resource.data) || request.resource.data.credits is map))
                // 3) 정산 확정 — 게임 종료 배치(playing → waiting)와 함께만 성립한다. 커밋 후 방 상태가
                //    waiting이어야 하므로 종료 없이 result만 쓰거나 종료 뒤에 고쳐 쓸 수 없다. 같은 차수를
                //    재시작해 다시 종료하면(방이 다시 playing) 덮어쓰기가 허용된다 — 마지막 종료가 정본.
                //    네 맵은 형태만 본다(수치 검증은 클라 계산 신뢰 — 서버 함수 부재 전제).
                || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['result'])
                  && getAfter(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'waiting'
                  && request.resource.data.result.keys().hasAll(['teamScores', 'playerScores', 'playerTiers', 'playerPoints', 'finishedAt'])
                  && request.resource.data.result.keys().hasOnly(['teamScores', 'playerScores', 'playerTiers', 'playerPoints', 'finishedAt'])
                  && request.resource.data.result.teamScores is map
                  && request.resource.data.result.playerScores is map
                  && request.resource.data.result.playerTiers is map
                  && request.resource.data.result.playerPoints is map
                  && request.resource.data.result.finishedAt == request.time)
              ))
            // 4) 배정 뒤 내보내기(2026-10-09 리허설 문제 8) — 게임 시작 전에 내보낸 참가자를 그 차수
            //    완장 목록에서 뺀다. 강퇴(참가자 문서 삭제)와 같은 배치로 오고 teams만 바꾼다. 정산이
            //    끝난(result 있는) 원장은 이미 뛴 라운드라 고칠 수 없다. 완장을 더하거나 지울 수 없고 한
            //    번에 한 팀의 목록만 바뀐다(이미 빠진 사람을 다시 빼는 무변경 쓰기도 통과 — 강퇴가 멱등이라).
            //    목록 내용은 다른 갈래처럼 클라 계산을 신뢰한다(서버 함수 부재 전제).
            || (get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'waiting'
              && !('result' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teams'])
              && request.resource.data.teams is map
              && request.resource.data.teams.diff(resource.data.teams).addedKeys().size() == 0
              && request.resource.data.teams.diff(resource.data.teams).removedKeys().size() == 0
              && request.resource.data.teams.diff(resource.data.teams).changedKeys().size() <= 1)
            // 5) 같은 차수 재배정(P10) — 게임을 시작하지 않은 차수를 다시 짜면 편성 스냅샷을 통째로
            //    다시 쓴다(배정 확정 배치의 set). 키는 1번 create 갈래와 같은 네 개뿐이고, 모드는 같은
            //    배치가 커밋한 방 모드와 같아야 한다. 정산이 끝난(result 있는) 원장은 고칠 수 없다.
            || (isUnplayedRoundReassign(roomCode)
              && !('result' in resource.data)
              && request.resource.data.keys().hasAll(['mode', 'teams', 'xTeams', 'confirmedAt'])
              && request.resource.data.keys().hasOnly(['mode', 'teams', 'xTeams', 'confirmedAt'])
              && request.resource.data.mode
                == getAfter(/databases/$(database)/documents/rooms/$(roomCode)).data.gameMode
              && request.resource.data.teams is map
              && request.resource.data.xTeams is list
              && request.resource.data.confirmedAt == request.time)
          );

        // 원장은 지우지 않는다(정정은 재시작 → 재종료로만). 방 삭제(P09) 때만 방과 함께 지운다.
        allow delete: if isDeletingRoomHost(roomCode);
      }
    }
  }
}
