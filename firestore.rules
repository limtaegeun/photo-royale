rules_version = '2';

// Firestore 보안 규칙의 단일 진실원. 변경 후 `firebase deploy --only firestore:rules`로
// 배포한다(firebase.json에 연결됨). 콘솔에서 직접 수정하면 이 파일과 어긋나므로 금지.
service cloud.firestore {
  match /databases/{database}/documents {
    // 신규 users 문서 스키마 검증 — 필드 화이트리스트 + 타입/값/길이 제약.
    // 정상 클라이언트(useSignup)와 같은 규칙(닉네임 2~12자, 한글·영문·숫자)을 서버에서도
    // 강제해, SDK 직접 호출로 예약 키와 다른 표시 닉네임·임의 필드·비정상 gender를
    // 쓰는 것을 막는다. 한계: rules는 NFC 정규화를 못 하므로 유니코드 정규화 자체는
    // 클라이언트(toNicknameKey) 책임으로 남는다.
    function isValidNewUser(data) {
      return data.keys().hasAll(['email', 'nickname', 'nicknameKey', 'gender', 'createdAt'])
        && data.keys().hasOnly(['email', 'nickname', 'nicknameKey', 'gender', 'createdAt'])
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 320
        && data.nickname is string
        && data.nickname.size() >= 2
        && data.nickname.size() <= 12
        && data.nickname.matches('^[가-힣ㄱ-ㅎㅏ-ㅣA-Za-z0-9]+$')
        && data.nicknameKey == data.nickname.lower()
        && data.gender in ['male', 'female']
        && data.createdAt == request.time; // serverTimestamp()는 rules에서 request.time과 같다
    }

    // 라운드 타이머(rooms/{code}.round) 스키마 검증 — 필드 화이트리스트 + 타입/값 제약.
    // 남은 시간은 저장하지 않고 앵커(startedAt) + 총량(durationMs)으로만 표현한다
    // (src/features/round-ops/api/round.ts writeRound과 같은 규칙).
    // durationMs 상한(3시간=10800000)은 클라의 ROUND_DURATION_MAX_MS와 **숫자까지 동일**해야
    // 하며 round.spec이 이 파일을 읽어 대조 검증한다 — 변경 시 양쪽을 함께 갱신·배포할 것.
    function isValidRound(round) {
      return round.keys().hasAll(['status', 'startedAt', 'durationMs'])
        && round.keys().hasOnly(['status', 'startedAt', 'durationMs', 'pausedRemainingMs'])
        && round.status in ['running', 'paused']
        && round.startedAt is timestamp
        && round.durationMs is int
        && round.durationMs >= 0
        && round.durationMs <= 10800000
        // 정지 중에만 남은 시간을 고정한다. 진행 중에 이 필드가 남아 있으면 어느 값이 정본인지
        // 모호해지므로 부재를 강제한다.
        && (round.status == 'paused'
          ? (round.pausedRemainingMs is int
            && round.pausedRemainingMs >= 0
            && round.pausedRemainingMs <= 10800000)
          : !('pausedRemainingMs' in round));
    }

    // 닉네임 유니크 인덱스. 문서 ID = 정규화 키(trim → NFC → lowercase,
    // src/features/auth/api/signup.ts toNicknameKey와 동일 규칙), 내용은 소유자 uid뿐.
    match /nicknames/{nickname} {
      // 가입 폼의 미인증 가용성 검사는 단건 get만 허용하고,
      // list를 막아 닉네임 전체 수집을 방지한다.
      allow get: if true;
      allow list: if false;

      // 존재하지 않는 키에만 create가 성립하므로 유니크가 서버에서 강제된다.
      // 같은 트랜잭션에서 users/{uid}가 이 키를 nicknameKey로 참조해야 한다(getAfter).
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.nicknameKey == nickname;

      // 닉네임 변경/탈퇴 플로우 도입 전까지 예약은 불변이다.
      allow update, delete: if false;
    }

    match /users/{uid} {
      // 프로필(이메일 포함)은 본인만 읽는다. 닉네임 가용성 검사는 nicknames 컬렉션이
      // 담당하므로 users를 공개로 열 이유가 없다.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;

      // 본인 문서이면서 스키마 검증(isValidNewUser)을 통과하고, 같은 트랜잭션에
      // 닉네임 예약이 함께 있어야 생성된다(상호 참조).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isValidNewUser(request.resource.data)
        && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nicknameKey)).data.uid == uid;

      // 프로필 수정 플로우 도입 시 닉네임 재예약 규칙과 함께 재설계한다.
      allow update, delete: if false;
    }

    // 대기실. 문서 ID = 초대 코드(waiting-room/api/rooms.ts generateRoomCode와 동일 형식 —
    // 혼동 문자 0/O·1/I/L 제외 4자).
    match /rooms/{roomCode} {
      // 초대 코드를 아는 로그인 사용자만 단건 조회한다(입장 전 코드 검증·참가 트랜잭션).
      allow get: if request.auth != null;

      // list는 "내가 만든 방" 조회(where hostUid == 본인)를 만족하는 쿼리만 허용한다 —
      // 조건 없는 전체 방 코드 수집은 계속 거부된다(fetchMyRooms 참조).
      allow list: if request.auth != null
        && resource.data.hostUid == request.auth.uid;

      // 존재하지 않는 코드에만 create가 성립하므로(createRoom 트랜잭션의 존재 검사와 함께)
      // 코드 유니크가 서버에서 강제된다. 정규식은 rooms.ts의 ROOM_CODE_ALPHABET·LENGTH와
      // 같은 규칙이어야 한다(rooms.spec이 대조 검증) — 변경 시 양쪽을 함께 갱신·배포할 것.
      allow create: if request.auth != null
        && roomCode.matches('^[A-HJKMNP-Z2-9]{4}$')
        && request.resource.data.keys().hasOnly(['hostUid', 'status', 'createdAt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt == request.time;

      // 호스트 본인만. 두 갈래로 나뉜다.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.hostUid
        && (
          // 1) 게임 시작 — status 필드만, waiting → playing 단방향 전이만 허용한다.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && resource.data.status == 'waiting'
            && request.resource.data.status == 'playing')
          // 2) 배정 확정 — 팀편성 차수(+1)와 게임 모드, 그리고 차수 → 모드 이력(roundModes)을
          //    함께 커밋한다. 아직 대기 중일 때만 허용한다.
          //    모드는 확정과 함께만 커밋된다(드래프트는 로컬) — assignmentRound +1 제약을 유지하므로
          //    모드만 단독으로 바꾸는 요청은(차수가 그대로라) 거부된다.
          //    아래 모드 리스트는 src/features/game-mode/registry.ts의 GAME_MODE_IDS와 일치해야
          //    한다(registry.spec이 대조 검증) — 새 모드 추가 시 여기도 갱신하고 rules를 배포할 것.
          //    roundModes는 gameMode가 덮어써져 사라지는 과거 라운드 모드를 남기는 이력 맵이다.
          //    이번 확정 차수의 키 하나만 추가/변경할 수 있고 값은 함께 커밋되는 gameMode와 같아야
          //    한다(모드 화이트리스트 검증은 위 gameMode 조건이 이미 수행하므로 등식으로 전이된다).
          //    기존 키 변조·삭제는 diff의 affectedKeys 제약이 막는다. 필드가 실제로 실렸을 때만
          //    검증하므로, roundModes를 모르는 구버전 클라이언트의 확정도 그대로 통과한다(배포 순서 자유).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignmentRound', 'gameMode', 'roundModes'])
            && resource.data.status == 'waiting'
            && request.resource.data.assignmentRound is int
            && request.resource.data.assignmentRound ==
              (('assignmentRound' in resource.data) ? resource.data.assignmentRound + 1 : 1)
            && request.resource.data.gameMode in ['normal', 'tail-chase', 'group', 'king-hunt', 'staff-chase', 'bomb-plant', 'kkomkkomi', 'fast-survival']
            && (!('roundModes' in request.resource.data)
              || (request.resource.data.roundModes is map
                && request.resource.data.roundModes.diff(resource.data.get('roundModes', {})).affectedKeys()
                  .hasOnly([string(request.resource.data.assignmentRound)])
                && request.resource.data.roundModes[string(request.resource.data.assignmentRound)]
                  == request.resource.data.gameMode)))
          // 3) 라운드 운영(H04) — 게임이 진행 중일 때만 round 맵을 통째로 갱신한다.
          //    시작·정지·재개·시간 반영이 모두 같은 갈래를 탄다(전이 종류는 클라가 결정하고,
          //    서버는 결과 문서가 유효한 라운드 상태인지만 본다).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['round'])
            && resource.data.status == 'playing'
            && isValidRound(request.resource.data.round))
          // 4) 게임 종료 — playing → waiting으로 되돌리며 진행 중인 라운드를 지운다.
          //    1번 갈래가 status를 단방향으로만 열어 두어 오시작을 콘솔로만 되돌릴 수 있었다.
          //    되돌리기는 status와 round를 **한 번에** 바꿔야 하므로(둘로 나누면 라운드만 남거나
          //    대기 상태에 라운드가 붙은 중간 상태가 보인다) 두 키를 함께 허용하는 갈래를 둔다.
          //    round가 없던(시작 전) 방은 affectedKeys가 ['status']뿐이라 hasOnly가 그대로 통과한다.
          //    배정 이력(assignmentRound·완장)은 건드리지 않는다 — 대기실로 돌아가 재배정하면
          //    기존 라운드 루프가 그대로 이어진다.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'round'])
            && resource.data.status == 'playing'
            && request.resource.data.status == 'waiting'
            && !('round' in request.resource.data))
        );

      // 방 정리(삭제) 플로우 도입 전까지 불변이다.
      allow delete: if false;

      // 참가자. 문서 ID = 참가자 uid — 재입장(joinRoom)이 자연스럽게 멱등이 된다.
      match /participants/{uid} {
        // 명단은 같은 방 사람끼리 실시간 구독으로 봐야 한다. 경로 접근에 초대 코드가
        // 필요하므로 로그인 사용자 전체 허용으로 충분하다(MVP).
        allow read: if request.auth != null;

        // 본인 문서만, 대기(isReady=false) 상태로, 존재하는 방에만 생성한다.
        // 닉네임은 users 스키마와 같은 제약(2~12자, 한글·영문·숫자)을 강제한다.
        // gender는 명단 표기용 optional — 있으면 값을 검증한다(프로필 조회 실패 시 생략 허용).
        allow create: if request.auth != null
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/rooms/$(roomCode))
          && request.resource.data.keys().hasAll(['nickname', 'isReady', 'joinedAt'])
          && request.resource.data.keys().hasOnly(['nickname', 'gender', 'isReady', 'joinedAt'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 2
          && request.resource.data.nickname.size() <= 12
          && request.resource.data.nickname.matches('^[가-힣ㄱ-ㅎㅏ-ㅣA-Za-z0-9]+$')
          && (!('gender' in request.resource.data) || request.resource.data.gender in ['male', 'female'])
          && request.resource.data.isReady == false
          && request.resource.data.joinedAt == request.time;

        // 두 갈래로 나뉜다.
        allow update: if
          // 1) 본인의 레디 확정만 허용한다(레디 해제 플로우는 아직 없다).
          (request.auth != null
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReady'])
            && request.resource.data.isReady == true)
          // 2) 호스트 배정 확정 배치 쓰기 — 드래프트는 로컬이라 확정 시에만 서버에 닿는다.
          //    team(완장)·확정 차수·X 겸직·이월값을 쓰고, 라운드마다 재레디를 위해 isReady를 false로 리셋한다.
          //    assignedRound는 getAfter로 방 문서의 커밋 후 assignmentRound와 일치해야 한다 —
          //    즉 참가자 배정 쓰기는 방 차수 증가와 같은 배치에만 성립한다(참가자만 단독 수정 불가).
          || (request.auth != null
            && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['team', 'assignedRound', 'isXTeam', 'sameGenderStreak', 'previousPartnerIds', 'isReady'])
            && request.resource.data.team is string
            && request.resource.data.team.size() == 1
            && request.resource.data.team.matches('^[A-Z]$')
            && request.resource.data.assignedRound is int
            && request.resource.data.assignedRound ==
              getAfter(/databases/$(database)/documents/rooms/$(roomCode)).data.assignmentRound
            && request.resource.data.isXTeam is bool
            && request.resource.data.sameGenderStreak is int
            && request.resource.data.sameGenderStreak >= 0
            && request.resource.data.previousPartnerIds is list
            && request.resource.data.isReady == false);

        // 퇴장(문서 삭제) 처리 도입 전까지 참가 기록은 불변이다.
        allow delete: if false;
      }

      // 진행자 공지. append-only 히스토리 — 운영 탭은 최신 1건을 구독하고,
      // 기록 탭(후속)이 같은 컬렉션을 전체 이력으로 읽는다.
      match /notices/{noticeId} {
        // 참가자가 같은 방 경로로 구독한다(participants와 동일 정책 — 경로 접근에 초대 코드 필요).
        allow read: if request.auth != null;

        // 호스트 본인만 발행한다. 길이 상한(100)은 src/features/round-ops/api/notices.ts의
        // NOTICE_TEXT_MAX_LENGTH와 같아야 한다(notices.spec이 대조 검증).
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 100
          && request.resource.data.createdAt == request.time;

        // 보낸 공지는 정정하지 않고 새 공지로 덮는다(이력 보존).
        allow update, delete: if false;
      }

      // 킬샷 제출·판정 큐. 참가자가 append하고 호스트가 pending → approved/rejected로
      // 한 번만 판정한다(재판정·삭제 없음). 사진은 Storage 없이 JPEG 데이터 URL로 문서에
      // 인라인 저장한다(문서 한도 1MiB 안에서 클라이언트가 다운스케일·압축한다).
      match /submissions/{submissionId} {
        // 사진 원문(data URL)은 민감하고 용량도 크다. 방 호스트 또는 실제 참가자만 열람한다.
        // 초대 코드를 알기만 하는 다른 로그인 사용자의 단건 조회·전체 큐 구독은 거부한다.
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
            || exists(/databases/$(database)/documents/rooms/$(roomCode)/participants/$(request.auth.uid)));

        // 이번 라운드에 배정된 참가자 본인만 제출한다. team/round는 위조를 막기 위해
        // 본인 참가자 문서·방 문서와 대조한다(같은 문서 get은 평가 안에서 캐시된다).
        // photo 길이 상한(900000)은 src/features/round-ops/api/submissions.ts의
        // SUBMISSION_PHOTO_MAX_LENGTH와 **숫자까지 동일**해야 한다(submissions.spec이 대조 검증).
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['uid', 'team', 'round', 'photo', 'status', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'team', 'round', 'photo', 'status', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'playing'
          // 정지(paused) 중·라운드 시작 전 제출을 서버에서도 차단한다(클라 잠금과 같은 기준).
          // rules의 get은 같은 문서라 추가 비용이 없다.
          && ('round' in get(/databases/$(database)/documents/rooms/$(roomCode)).data)
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.round.status == 'running'
          // 마감(0:00) 이후 도착분은 거부한다 — 라운드가 끝난 뒤 올라온 사진은 킬로 인정하지 않는다.
          // 클라(카메라)는 이미 셔터·제출을 잠그지만 그것만으로는 클라를 우회한 쓰기가 통과하고,
          // 마감 직전 제출이 업로드 지연으로 늦게 도착하는 경우도 걸러지지 않는다.
          //
          // 마감 시각은 `startedAt + durationMs` 하나로 정해진다 — writeRound가 모든 전이
          // (시작·정지·재개·시간 반영)를 "지금부터 남은 시간만큼"으로 다시 앵커하기 때문에,
          // 진행자가 ±N분을 반영하면 이 식이 그대로 따라온다. 판정 기준 시각은 호스트 기기가
          // 아니라 요청이 서버에 닿은 시각(request.time)이라 참가자 기기 시계는 개입하지 못한다.
          // 경계는 클라의 종료 판정(remainingMs == 0 → 'ended')과 같다.
          && request.time < get(/databases/$(database)/documents/rooms/$(roomCode)).data.round.startedAt
            + duration.value(get(/databases/$(database)/documents/rooms/$(roomCode)).data.round.durationMs, 'ms')
          && request.resource.data.round is int
          && request.resource.data.round
            == get(/databases/$(database)/documents/rooms/$(roomCode)).data.assignmentRound
          && request.resource.data.team
            == get(/databases/$(database)/documents/rooms/$(roomCode)/participants/$(request.auth.uid)).data.team
          && request.resource.data.round
            == get(/databases/$(database)/documents/rooms/$(roomCode)/participants/$(request.auth.uid)).data.assignedRound
          && request.resource.data.photo is string
          && request.resource.data.photo.size() >= 1
          && request.resource.data.photo.size() <= 900000
          && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;

        // 판정 — 호스트 본인이 pending에 한해 한 번만(단방향). approved(확정)면 잡힌 팀의
        // 완장(targetTeam)이 필수이고, rejected(반려)는 사유 없이 상태만 남긴다.
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'playing'
          && resource.data.status == 'pending'
          && resource.data.round
            == get(/databases/$(database)/documents/rooms/$(roomCode)).data.assignmentRound
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'targetTeam', 'targetParticipantUid', 'judgedAt'])
          && request.resource.data.judgedAt == request.time
          && (
            (request.resource.data.status == 'approved'
              && request.resource.data.targetTeam is string
              && request.resource.data.targetTeam.size() == 1
              && request.resource.data.targetTeam.matches('^[A-Z]$')
              && request.resource.data.targetTeam != resource.data.team
              && request.resource.data.targetParticipantUid is string
              && request.resource.data.targetTeam
                == get(/databases/$(database)/documents/rooms/$(roomCode)/participants/$(request.resource.data.targetParticipantUid)).data.team
              && resource.data.round
                == get(/databases/$(database)/documents/rooms/$(roomCode)/participants/$(request.resource.data.targetParticipantUid)).data.assignedRound)
            || (request.resource.data.status == 'rejected'
              && !('targetTeam' in request.resource.data)
              && !('targetParticipantUid' in request.resource.data))
          );

        // 판정 이력은 정정하지 않는다(재판정·삭제 플로우 없음).
        allow delete: if false;
      }
    }
  }
}
